# Copy to .env.local for development. Set the same variables in the host dashboard (Vercel:
# Project > Settings > Environment Variables). Never commit real values.

# --- Quote form email (required in production) ---------------------------------------------
# Resend API key: https://resend.com > API Keys. Verify the jaysnagro.com domain in Resend first.
RESEND_API_KEY=
# Where enquiries go. Comma separate several addresses.
ENQUIRY_TO=info@jaysnagro.com
# Sender shown on the enquiry email. Must be on the verified domain.
ENQUIRY_FROM="JAYSN AGRO website <website@jaysnagro.com>"

# --- Analytics (optional) -------------------------------------------------------------------
# Cookie free Plausible analytics. Leave empty to load no analytics at all.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# --- Content guard ---------------------------------------------------------------------------
# 1 makes `npm run check:content` fail while any company fact is unverified.
# `npm run build:production` sets it for you. Use that command for the live site.
STRICT_CONTENT=
# 1 hides the small gold TBC markers on unverified facts (for client preview screenshots only).
NEXT_PUBLIC_HIDE_TBC=
